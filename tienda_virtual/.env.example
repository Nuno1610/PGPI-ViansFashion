# Copia este archivo como .env y rellena tus claves privadas.
# NO subas el archivo .env real al repositorio.
# Este archivo solo sirve como plantilla.

# Clave secreta de Django. Genera una aleatoria para cada entorno.
SECRET_KEY='cambia-esta-clave-por-una-aleatoria'

# En desarrollo local suele ser True. En producción debe ser False.
DEBUG=True

# Hosts permitidos para local. Añade más si usas otro dominio o puerto.
ALLOWED_HOSTS='localhost,127.0.0.1,0.0.0.0'

# Configuración del correo SMTP (Gmail u otro proveedor).
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER='tu-email@gmail.com'
EMAIL_HOST_PASSWORD='tu-contraseña-de-aplicación'
DEFAULT_FROM_EMAIL='tu-email@gmail.com'

# Claves de Stripe para pagos.
# Public key: se usa en el frontend.
# Secret key: se usa en el backend.
# Webhook secret: se usa para validar eventos de Stripe.
STRIPE_PUBLIC_KEY='pk_test_tu_public_key'
STRIPE_SECRET_KEY='sk_test_tu_secret_key'
STRIPE_WEBHOOK_SECRET='whsec_tu_webhook_secret'
